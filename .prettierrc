{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "spaceBeforeFunctionParen": true,
  "rangeStart": 0,
  "requirePragma": false,
  "insertPragma": false,
  "objectCurlySpacing": true
}
